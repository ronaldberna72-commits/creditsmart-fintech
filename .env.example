# Credenciales de Firebase Web App (Consola de Firebase > Configuración del proyecto)
# Nota: Si dejas estos valores vacíos, la aplicación funcionará automáticamente en Modo Demo Local (localStorage)
# para que puedas probar todas las funciones sin configuración previa.

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
